{
  "name": "pf-ai-agent",
  "version": "1.0.0",
  "description": "AI agent that helps people fix rejected and stuck EPF claims",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
