GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Web server
PORT=3000
# Long random string; unlocks /admin (team queue). Leave empty to disable.
ADMIN_KEY=
# Your WhatsApp number with country code, e.g. 919000000000 (shown as "WhatsApp us")
SUPPORT_WHATSAPP=
# Success fee shown on the home page ("pay only after your money arrives" is added automatically)
PRICE_TEXT=₹999
# Where cases are stored (default ./data)
DATA_DIR=
